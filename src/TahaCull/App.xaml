<Application x:Class="TahaCull.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#1B1B1F"/>
    <SolidColorBrush x:Key="Panel" Color="#26262C"/>
    <SolidColorBrush x:Key="Fg" Color="#ECECEC"/>
    <SolidColorBrush x:Key="Dim" Color="#9A9AA2"/>
    <SolidColorBrush x:Key="Accent" Color="#D4A84B"/>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="8,0"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#33333A"/>
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="BorderBrush" Value="#44444C"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="CaretBrush" Value="{StaticResource Fg}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#3A3A42"/>
      <Setter Property="Foreground" Value="{StaticResource Fg}"/>
      <Setter Property="BorderBrush" Value="#55555E"/>
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="Margin" Value="4,0"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="#1B1B1F"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </Application.Resources>
</Application>
