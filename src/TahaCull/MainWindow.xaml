<Window x:Class="TahaCull.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TahaCull · client picks → CR3" Height="900" Width="1400" MinWidth="900" MinHeight="600"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">

  <DockPanel>
    <!-- Folders + match -->
    <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" Padding="12">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
          </Grid.RowDefinitions>
          <TextBlock Text="CR3 folder (with subfolders)"/>
          <TextBox x:Name="Cr3Box" Grid.Column="1" Margin="0,3"/>
          <Button Grid.Column="2" Content="Browse…" Click="BrowseCr3_Click"/>
          <TextBlock Grid.Row="1" Text="Client pictures folder"/>
          <TextBox x:Name="ClientBox" Grid.Row="1" Grid.Column="1" Margin="0,3"/>
          <Button Grid.Row="1" Grid.Column="2" Content="Browse…" Click="BrowseClient_Click"/>
        </Grid>
        <DockPanel Margin="0,10,0,0">
          <Button x:Name="MatchButton" Style="{StaticResource PrimaryButton}" Content="Auto match" Click="Match_Click" Margin="0,0,8,0"/>
          <TextBlock Text="Preview size" Foreground="{StaticResource Dim}" Margin="12,0,6,0" DockPanel.Dock="Right"/>
          <Slider x:Name="SizeSlider" Width="160" Minimum="140" Maximum="700" Value="280" DockPanel.Dock="Right" VerticalAlignment="Center"
                  ValueChanged="SizeSlider_ValueChanged"/>
          <CheckBox x:Name="OnlyCheckBox" Content="Show only to check" DockPanel.Dock="Right" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
          <ProgressBar x:Name="Progress" Width="220" Height="8" Margin="8,0" Visibility="Collapsed"/>
          <TextBlock x:Name="StatusText" Foreground="{StaticResource Dim}" Margin="8,0" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
      </StackPanel>
    </Border>

    <!-- Output -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" Padding="12">
      <DockPanel>
        <Button DockPanel.Dock="Right" x:Name="CopyButton" Style="{StaticResource PrimaryButton}" Content="Copy confirmed CR3" Click="Copy_Click" IsEnabled="False"/>
        <StackPanel Orientation="Horizontal">
          <Button Content="Confirm all" Click="ConfirmAll_Click"/>
          <Button Content="Unconfirm all" Click="UnconfirmAll_Click"/>
          <TextBlock Text="Save to" Margin="16,0,6,0"/>
          <TextBox x:Name="OutBox" Width="380"/>
          <Button Content="Browse…" Click="BrowseOut_Click"/>
          <CheckBox x:Name="RenameBox" Content="Rename client pictures to the CR3 name" IsChecked="True"/>
          <CheckBox x:Name="XmpBox" Content="Copy .xmp sidecars" IsChecked="True"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Pairs -->
    <ListBox x:Name="PairList" Background="{StaticResource Bg}" BorderThickness="0"
             HorizontalContentAlignment="Stretch"
             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
             VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="Padding" Value="0"/>
          <Setter Property="Margin" Value="10,6"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <ContentPresenter/>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Background="{StaticResource Panel}" CornerRadius="6" Padding="10" BorderThickness="0,0,0,3" BorderBrush="{Binding StatusBrush}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <StackPanel>
                <TextBlock Text="Client" Foreground="{StaticResource Dim}" FontSize="11"/>
                <Image Source="{Binding ClientThumb}" Height="{Binding ThumbHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <TextBlock Text="Original" Foreground="{StaticResource Dim}" FontSize="11"/>
                <Image Source="{Binding Selected.Thumb}" Height="{Binding ThumbHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
              </StackPanel>

              <StackPanel Grid.Column="2" Margin="16,0,0,0">
                <TextBlock Text="{Binding ClientName}" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Selected.Name, FallbackValue='—'}" FontSize="24" FontWeight="SemiBold" Margin="0,2"/>
                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" TextWrapping="Wrap"/>
                <CheckBox Content="Confirmed" IsChecked="{Binding Confirmed}" Margin="0,10" FontSize="15"/>

                <TextBlock Text="Other close photos (click to choose):" Foreground="{StaticResource Dim}" FontSize="11" Margin="0,4,0,2"/>
                <ItemsControl ItemsSource="{Binding Candidates}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Click="Candidate_Click" Padding="3" Margin="0,0,6,6" Background="Transparent">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="BorderBrush" Value="#44444C"/>
                            <Setter Property="BorderThickness" Value="2"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                        <StackPanel>
                          <Image Source="{Binding Thumb}" Height="80" Stretch="Uniform"/>
                          <TextBlock Text="{Binding Name}" FontSize="11" HorizontalAlignment="Center"/>
                          <TextBlock Text="{Binding ScoreText}" FontSize="10" Foreground="{StaticResource Dim}" HorizontalAlignment="Center"/>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                  <TextBlock Text="Or type a name:" Foreground="{StaticResource Dim}" Margin="0,0,6,0"/>
                  <TextBox Width="140" Text="{Binding ManualName, UpdateSourceTrigger=PropertyChanged}" KeyDown="ManualName_KeyDown"/>
                  <Button Content="Use" Click="ManualName_Click"/>
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
